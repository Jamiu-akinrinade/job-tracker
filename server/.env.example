# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already in .gitignore.

# Server
PORT=4000

# PostgreSQL — local installation
# Format: postgresql://user:password@host:port/database
# If you created the user/db with: CREATE USER jobapp WITH PASSWORD 'secret';
#                                   CREATE DATABASE jobtracker OWNER jobapp;
# then use:
DATABASE_URL=postgresql://jobapp:secret@localhost:5432/jobtracker

# USER_ID: the "seed" user (id 1, created by sql/01_init.sql).
# Until Step 5 adds real JWT login, every API request acts as this one user.
USER_ID=1

# JWT secret (used later in Step 4 — generate a long random string, e.g. with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Node environment
NODE_ENV=development
